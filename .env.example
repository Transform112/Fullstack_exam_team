# Public base URL of the app, no trailing slash. Used for share links, OG tags, CORS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Extra origins allowed to call mutating endpoints, comma separated (the app URL is always allowed).
ALLOWED_ORIGINS=http://localhost:3000
# MongoDB connection string including the database name, for example mongodb+srv://user:pass@cluster/wishly
MONGO_URI=
# Long random secret used only to sign auth tokens.
JWT_SECRET=
# Auth token lifetime accepted by jsonwebtoken, for example 7d or 12h.
JWT_EXPIRES_IN=7d
# Independent random secret for password-page unlock tokens.
UNLOCK_JWT_SECRET=
# Independent random secret used to hash client IP addresses.
IP_HASH_SECRET=
# Cloudinary cloud name from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key.
CLOUDINARY_API_KEY=
# Cloudinary API secret. Server only. Never expose to the browser.
CLOUDINARY_API_SECRET=
# Optional operator admin created by the seed in addition to admin@demo.com / creator@demo.com.
SEED_ADMIN_EMAIL=
# Password for SEED_ADMIN_EMAIL. Leave empty to skip creating that account.
SEED_ADMIN_PASSWORD=
# Bonus: Vercel API token for programmatic deploy.
VERCEL_TOKEN=
# Bonus alternative: Netlify API token.
NETLIFY_AUTH_TOKEN=
# Bonus: key for AI message suggestions (Google AI Studio / Gemini free tier).
GEMINI_API_KEY=
